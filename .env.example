# 지도 SDK 연동 시 사용 (현재 mock map 사용 중, 키를 소스에 하드코딩하지 마세요)
VITE_KAKAO_MAP_KEY=
VITE_NAVER_MAP_CLIENT_ID=

# 카카오톡 공유 SDK (키가 없으면 링크 복사 폴백이 동작합니다)
VITE_KAKAO_SHARE_KEY=

# 실제 백엔드 연동 시 사용
VITE_API_BASE_URL=

# Supabase (제보 데이터베이스) — 대시보드 → Project Settings → API에서 확인
# 미설정 시 브라우저 mock 저장소로 폴백합니다. anon 키만 사용 (service_role 금지)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
